{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "snowy",
    "main": "src/index.ts",
    "account_id": "7ab77eaa396c9a6435e5659a299e07cf",
    "compatibility_date": "2026-11-16",
    "observability": { "enabled": true },
    // Workers AI binding: all inference goes through env.AI.run(); no REST credentials in the Worker.
    "ai": { "binding": "AI", "remote": true },
    // Per-client-IP request limiter (Workers Rate Limiting API). Tune limit/period to taste.
    "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } }],
    "vars": {
        // Hard cap on request body size in bytes (Codex resends full history every turn).
        "MAX_BODY_BYTES": "4000000",
        // Default model when a request omits "model" (Codex always sends one).
        "DEFAULT_MODEL": "@cf/zai-org/glm-4.7-flash",
        // "paid" lists + accepts Workers Paid-only models (DeepSeek V4, GLM-5.3, ...). setup.sh detects and sets this.
        "WORKERS_PLAN": "paid",
    },
    // SNOWY_API_KEY is a secret: `wrangler secret put SNOWY_API_KEY` (never put it here).
}
